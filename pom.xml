<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.fizkarlsruhe</groupId>
  <artifactId>konclude-protege</artifactId>
  <version>0.1.0</version>
  <packaging>bundle</packaging>

  <name>Konclude Reasoner Plugin for Protégé</name>
  <description>Protégé 5 reasoner plugin that delegates reasoning to the Konclude command line tool.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <protege.version>5.6.4</protege.version>
    <junit.version>5.10.3</junit.version>
  </properties>

  <dependencies>
    <!-- provided by Protégé at runtime (brings OWL API 4.5.x) -->
    <dependency>
      <groupId>edu.stanford.protege</groupId>
      <artifactId>protege-editor-owl</artifactId>
      <version>${protege.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the black-box explanation library used by Protégé's explanation workbench 3.0.1 -->
    <dependency>
      <groupId>net.sourceforge.owlapi</groupId>
      <artifactId>owlexplanation</artifactId>
      <version>2.0.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>net.sourceforge.owlapi</groupId>
          <artifactId>owlapi-osgidistribution</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.github.ansell.pellet</groupId>
          <artifactId>*</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.github.ignazio1977</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- reference reasoner for the comparison tests -->
    <dependency>
      <groupId>net.sourceforge.owlapi</groupId>
      <artifactId>org.semanticweb.hermit</artifactId>
      <version>1.3.8.431</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>net.sourceforge.owlapi</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <systemPropertyVariables>
            <konclude.path>${konclude.path}</konclude.path>
            <lp.ontology>${lp.ontology}</lp.ontology>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>5.1.9</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Bundle-SymbolicName>de.fizkarlsruhe.konclude-protege;singleton:=true</Bundle-SymbolicName>
            <Bundle-Name>Konclude Reasoner</Bundle-Name>
            <Bundle-Category>protege</Bundle-Category>
            <Bundle-Vendor>FIZ Karlsruhe</Bundle-Vendor>
            <Bundle-Description>Konclude (SROIQV(D)) reasoner for Protégé via the Konclude command line tool</Bundle-Description>
            <Export-Package>de.fizkarlsruhe.konclude.owlapi</Export-Package>
            <Private-Package>de.fizkarlsruhe.konclude.protege</Private-Package>
            <_noimportjava>true</_noimportjava>
            <Import-Package>
              org.protege.editor.*;version="[5.0,6)",
              org.semanticweb.owlapi.*;version="[4.5,5)",
              *
            </Import-Package>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
