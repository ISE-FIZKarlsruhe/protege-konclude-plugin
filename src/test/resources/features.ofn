Prefix(:=<http://example.org/features#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/features>

Declaration(Class(:Person))
Declaration(Class(:Parent))
Declaration(Class(:Mother))
Declaration(Class(:Father))
Declaration(Class(:Woman))
Declaration(Class(:Man))
Declaration(Class(:Human))
Declaration(Class(:Grandparent))
Declaration(Class(:Impossible))
Declaration(Class(:Country))
Declaration(Class(:EUCountry))
Declaration(Class(:GermanResident))
Declaration(Class(:Adult))
Declaration(Class(:Place))
Declaration(ObjectProperty(:hasChild))
Declaration(ObjectProperty(:hasParent))
Declaration(ObjectProperty(:hasDescendant))
Declaration(ObjectProperty(:hasGrandchild))
Declaration(ObjectProperty(:livesIn))
Declaration(ObjectProperty(:partOf))
Declaration(ObjectProperty(:locatedIn))
Declaration(ObjectProperty(:knows))
Declaration(DataProperty(:age))
Declaration(DataProperty(:yearsLived))
Declaration(NamedIndividual(:anna))
Declaration(NamedIndividual(:bob))
Declaration(NamedIndividual(:carl))
Declaration(NamedIndividual(:dora))
Declaration(NamedIndividual(:germany))
Declaration(NamedIndividual(:france))
Declaration(NamedIndividual(:karlsruhe))
Declaration(NamedIndividual(:robert))

# hierarchy, equivalence, unsatisfiable class
EquivalentClasses(:Person :Human)
SubClassOf(:Woman :Person)
SubClassOf(:Man :Person)
DisjointClasses(:Woman :Man)
EquivalentClasses(:Parent ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasChild :Person)))
EquivalentClasses(:Mother ObjectIntersectionOf(:Woman :Parent))
EquivalentClasses(:Father ObjectIntersectionOf(:Man :Parent))
EquivalentClasses(:Grandparent ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasChild :Parent)))
SubClassOf(:Impossible ObjectIntersectionOf(:Woman :Man))

# nominals
EquivalentClasses(:EUCountry ObjectOneOf(:germany :france))
SubClassOf(:EUCountry :Country)
EquivalentClasses(:GermanResident ObjectHasValue(:livesIn :germany))

# properties: inverse, transitive, chain, sub-properties, domain/range, functional
InverseObjectProperties(:hasChild :hasParent)
SubObjectPropertyOf(:hasChild :hasDescendant)
TransitiveObjectProperty(:hasDescendant)
SubObjectPropertyOf(ObjectPropertyChain(:hasChild :hasChild) :hasGrandchild)
ObjectPropertyDomain(:hasChild :Person)
ObjectPropertyRange(:hasChild :Person)
TransitiveObjectProperty(:partOf)
SubObjectPropertyOf(:partOf :locatedIn)
SymmetricObjectProperty(:knows)
FunctionalObjectProperty(:livesIn)

# data properties
SubDataPropertyOf(:age :yearsLived)
DataPropertyDomain(:age :Person)
EquivalentClasses(:Adult ObjectIntersectionOf(:Person DataSomeValuesFrom(:age DatatypeRestriction(xsd:integer xsd:minInclusive "18"^^xsd:integer))))

# individuals
ClassAssertion(:Woman :anna)
ClassAssertion(:Man :bob)
ObjectPropertyAssertion(:hasChild :anna :bob)
ObjectPropertyAssertion(:hasChild :bob :carl)
ClassAssertion(:Woman :dora)
ObjectPropertyAssertion(:hasParent :dora :bob)
ObjectPropertyAssertion(:livesIn :anna :germany)
ObjectPropertyAssertion(:partOf :karlsruhe :germany)
ObjectPropertyAssertion(:knows :anna :dora)
DataPropertyAssertion(:age :anna "70"^^xsd:integer)
DataPropertyAssertion(:age :carl "5"^^xsd:integer)
SameIndividual(:bob :robert)
ClassAssertion(:Place :karlsruhe)
)
